# Port the API listens on.
PORT=4000

# SQLite file. Keep it outside version control.
DATABASE_PATH=data/store.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Public URL of the storefront. Midtrans sends shoppers back here after paying.
SITE_URL=http://localhost:3000

# Public URL of this API. Email links and Google sign-in return here.
API_URL=http://localhost:4000

# Signs login sessions. Required in production: a long random string.
BETTER_AUTH_SECRET=

# Resend API key for sign up and password emails. Without it, emails are printed to the log.
RESEND_API_KEY=
# Sender address. It must be on a domain verified in Resend.
MAIL_FROM=

# Google sign-in. Authorized redirect URI: <API_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Biteship key for the area search in address forms.
BITESHIP_API_KEY=

# Midtrans keys, from the Access Keys page of the Midtrans dashboard.
# Sandbox keys start with SB-. Never commit the server key.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set to true only with production keys.
MIDTRANS_IS_PRODUCTION=false
