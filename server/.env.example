# Port the API listens on.
PORT=4000

# PostgreSQL. Leave empty in development to use PGlite in data/pglite, which
# needs nothing installed. In production use a postgres:// URL, such as the
# pooled connection string from Neon.
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
# Number of proxies in front of the API (load balancer, Nginx). Leave 0 when
# the API is reached directly, so client-sent forwarded headers are ignored.
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000

# Public URL of the storefront. Midtrans sends shoppers back here after paying.
SITE_URL=http://localhost:3000

# Public URL of this API. Email links and Google sign-in return here.
API_URL=http://localhost:4000

# Signs login sessions. Required in production: a long random string.
BETTER_AUTH_SECRET=

# Resend API key for sign up and password emails. Without it, emails are printed to the log.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. Dummy Store <halo@tokoanda.com>.
# Gmail or other public addresses are refused. Leave empty to use onboarding@resend.dev,
# which only delivers to the email of your own Resend account.
MAIL_FROM=

# Google sign-in. Authorized redirect URI: <API_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Biteship key for shipping rates and tracking. Address forms use the bundled region data.
BITESHIP_API_KEY=

# Midtrans keys, from the Access Keys page of the Midtrans dashboard.
# Sandbox keys start with SB-. Never commit the server key.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set to true only with production keys.
MIDTRANS_IS_PRODUCTION=false
