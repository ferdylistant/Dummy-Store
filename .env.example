# Public URL of the store, without a trailing slash. Used for canonical URLs,
# the sitemap, Open Graph tags, and structured data. Set this before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the Express API, used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional private URL of the API, used by the Next.js server.
# API_URL=http://localhost:4000

# Shared with the API (STORE_REVALIDATE_SECRET in server/.env). Lets the API
# clear the store's cache after dashboard changes. Development uses a fixed
# value when empty.
REVALIDATE_SECRET=
